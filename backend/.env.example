# Copy to .env and fill in your values.

# Base path all API routes are mounted under
API_URL=/api/v1

# Port the Express server listens on (frontend expects 5000)
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=school_management

# Secret used to sign/verify JWT access tokens — use a long random string
JWT_SECRET=change-me
